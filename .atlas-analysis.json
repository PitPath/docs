  "keyFeatures": [
    "License-based multi-tenancy with API key authentication",
    "Rig registration via hardware ID and signed license files",
    "Event management with simulator, car, and track layout associations",
    "Lap time recording with sector splits and validity tracking",
    "Participant management with custom signup fields per event",
    "CDN asset upload for logos, images, and SVG graphics",
    "Paginated list endpoints for all major resources",
    "Role-based access control (R, CR, CRUD, ADMIN)"
  ],
  "publicApiSurface": [
    "GET /api/v1/events",
    "POST /api/v1/events",
    "PATCH /api/v1/events/{eventId}",
    "GET /api/v1/laps",
